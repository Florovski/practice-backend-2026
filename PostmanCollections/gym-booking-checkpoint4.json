      "name": "0. Логин (admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var d = pm.response.json();",
              "if (d.token) pm.collectionVariables.set('admin_token', d.token);",
              "pm.test('Логин admin успешен', function() { pm.response.to.have.status(200); });",
              "pm.test('Токен получен', function() { pm.expect(d.token).to.be.a('string'); });"
            ]
          }
        }
      ],
      "request": {
