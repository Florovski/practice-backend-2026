    {
      "name": "11. Подготовка — установить past_booking_id из сидера",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var d = pm.response.json();",
              "pm.test('Статус 200', function() { pm.response.to.have.status(200); });",
              "var pastBooking = null;",
              "if (d.data) {",
              "  pastBooking = d.data.find(function(b) {",
              "    return b.resource_id === 3 && new Date(b.date) < new Date();",
              "  });",
              "}",
              "if (pastBooking) {",
              "  pm.collectionVariables.set('past_booking_id', pastBooking.id);",
              "  pm.test('past_booking_id найден: ' + pastBooking.id, function() {",
              "    pm.expect(pastBooking.id).to.be.above(0);",
              "  });",
              "} else {",
              "  pm.test('ОШИБКА: прошлое бронирование не найдено', function() { pm.expect(false).to.be.true; });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{user_token}}" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/bookings?per_page=50",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "bookings"],
          "query": [{ "key": "per_page", "value": "50" }]
        }
      }
    },
