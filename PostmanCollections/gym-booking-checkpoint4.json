    {
      "name": "7. Сортировка по цене (дешевле сначала)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var d = pm.response.json();",
              "pm.test('Статус 200', function() { pm.response.to.have.status(200); });",
              "pm.test('Сортировка по возрастанию цены', function() {",
              "  var prices = d.data.map(function(r) { return parseFloat(r.price_per_hour); });",
              "  for (var i = 1; i < prices.length; i++) {",
              "    pm.expect(prices[i]).to.be.at.least(prices[i-1]);",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "http://127.0.0.1:8000/api/resources?sort_by=price_per_hour&sort_dir=asc",
