    {
      "name": "10. Отзывы о зале (средний рейтинг)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var d = pm.response.json();",
              "pm.test('Статус 200', function() { pm.response.to.have.status(200); });",
              "pm.test('Есть average_rating', function() { pm.expect(d).to.have.property('average_rating'); });",
              "pm.test('Есть список отзывов', function() { pm.expect(d).to.have.property('reviews'); });",
              "pm.test('Рейтинг от 1 до 5', function() {",
              "  if (d.average_rating !== null) {",
              "    pm.expect(parseFloat(d.average_rating)).to.be.within(1, 5);",
              "  }",
