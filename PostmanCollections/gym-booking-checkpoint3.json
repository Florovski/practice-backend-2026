{
  "info": {
    "name": "Gym Booking — Checkpoint 3",
    "_postman_id": "gym-booking-checkpoint3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Логин (admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = pm.response.json();",
              "if (data.token) pm.collectionVariables.set('admin_token', data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@gym.com\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/auth/login",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "2. Логин (user)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = pm.response.json();",
              "if (data.token) pm.collectionVariables.set('user_token', data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@gym.com\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/auth/login",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "3. Успешное бронирование (user)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = pm.response.json();",
              "if (data.id) pm.collectionVariables.set('booking_id', data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{user_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resource_id\": 1,\n  \"date\": \"2026-03-20\",\n  \"start_time\": \"10:00\",\n  \"end_time\": \"12:00\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/bookings",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "bookings"]
        }
      }
    },
    {
      "name": "4. Пересечение по времени (ожидаем 422)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{user_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resource_id\": 1,\n  \"date\": \"2026-03-20\",\n  \"start_time\": \"11:00\",\n  \"end_time\": \"13:00\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/bookings",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "bookings"]
        }
      }
    },
    {
      "name": "5. Просмотр своих бронирований (user)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{user_token}}" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/bookings",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "bookings"]
        }
      }
    },
    {
      "name": "6. Просмотр всех бронирований (admin)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/bookings",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "bookings"]
        }
      }
    },
    {
      "name": "7. Отмена своего бронирования (user)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{user_token}}" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/bookings/{{booking_id}}",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "bookings", "{{booking_id}}"]
        }
      }
    },
    {
      "name": "8. Отмена уже отменённого (ожидаем 422)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{user_token}}" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/bookings/{{booking_id}}",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "bookings", "{{booking_id}}"]
        }
      }
    },
    {
      "name": "9. Отмена чужого бронирования от user (ожидаем 403)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{user_token}}" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/bookings/4",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "bookings", "4"]
        }
      }
    },
    {
      "name": "10. Отмена любого бронирования (admin)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/bookings/2",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "bookings", "2"]
        }
      }
    }
  ],
  "variable": [
    { "key": "admin_token", "value": "" },
    { "key": "user_token", "value": "" },
    { "key": "booking_id", "value": "" }
  ]
}
