{
  "info": {
    "name": "Gym Booking API Demo",
    "_postman_id": "gym-booking-api-demo-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Регистрация нового пользователя",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demoo User\",\n  \"email\": \"demoo@gym.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/auth/register",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "2. Логин (получить токен админа)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var data = pm.response.json();",
              "if (data.token) {",
              "  pm.collectionVariables.set('admin_token', data.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@gym.com\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/auth/login",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "3. Логин обычного пользователя (user)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var data = pm.response.json();",
              "if (data.token) {",
              "  pm.collectionVariables.set('user_token', data.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@gym.com\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/auth/login",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "4. Мой профиль (me)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/auth/me",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "auth", "me"]
        }
      },
      "response": []
    },
    {
      "name": "5. Создать зал (ADMIN — успешно)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Боксёрский зал\",\n  \"type\": \"boxing\",\n  \"capacity\": 10,\n  \"floor\": 2,\n  \"price_per_hour\": 600,\n  \"description\": \"Зал с боксёрскими грушами и рингом\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/resources",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "resources"]
        }
      },
      "response": []
    },
    {
      "name": "6. Просмотр списка залов",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/resources",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "resources"]
        }
      },
      "response": []
    },
    {
      "name": "7. Просмотр одного зала",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/resources/1",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "resources", "1"]
        }
      },
      "response": []
    },
    {
      "name": "8. Редактирование зала (ADMIN — успешно)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price_per_hour\": 550,\n  \"description\": \"Обновлённое описание зала\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/resources/1",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "resources", "1"]
        }
      },
      "response": []
    },
    {
      "name": "9. Удаление зала (ADMIN — успешно)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/resources/5",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "resources", "5"]
        }
      },
      "response": []
    },
    {
      "name": "10. Создать зал БЕЗ авторизации (ожидаем 401)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Тест без токена\",\n  \"type\": \"test\",\n  \"capacity\": 5,\n  \"floor\": 1,\n  \"price_per_hour\": 100\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/resources",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "resources"]
        }
      },
      "response": []
    },
    {
      "name": "11. Создать зал от обычного USER (ожидаем 403)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Тест от user\",\n  \"type\": \"test\",\n  \"capacity\": 5,\n  \"floor\": 1,\n  \"price_per_hour\": 100\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/resources",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "resources"]
        }
      },
      "response": []
    },
    {
      "name": "12. Выход из системы (logout)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/auth/logout",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "auth", "logout"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "user_token",
      "value": ""
    }
  ]
}
