# Docker Compose environment (copy to .env before first run)

APP_PORT=8000
SWAGGER_PORT=8081
DB_PORT_EXTERNAL=3307

APP_NAME=GymBookingAPI
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
JWT_SECRET=
LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gym_booking
DB_USERNAME=gym_user
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
